# Copy this file to .env and fill in your own values. Never commit .env.

# ---------------------------------------------------------------------------
# Default Stage-2 provider: "jev" or "gemini". The extension/web console can
# override it per request; this is only the server-side fallback.
# ---------------------------------------------------------------------------
SMART_FILTER_PROVIDER=jev

# ---------------------------------------------------------------------------
# Jev decision model, served through OpenRouter - https://openrouter.ai
# ---------------------------------------------------------------------------

# Required for the Jev provider. Create an OpenRouter key at
# https://openrouter.ai/settings/keys (it starts with `sk-or-v1-`); the Jev
# model is billed to your OpenRouter account. The .env key is loaded
# automatically by the service and never logged. JEV_API_KEY is still accepted
# as a backwards-compatible alias.
OPENROUTER_API_KEY=

# Optional overrides (defaults shown).
# typesafe/jev-1.13 is the pinned decision model; ~typesafe/jev-latest is a
# rolling alias, and the bare `jev-1.13` is also accepted by OpenRouter.
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=15000
JEV_MAX_RETRIES=2

# Optional: a custom User-Agent for Jev requests. OpenRouter does not require
# a browser signature; this only changes how requests are identified.
JEV_USER_AGENT=

# Optional: minimum probability Jev must give the "allow" label before a query
# is passed. Jev returns calibrated probabilities; when unset the winner label
# decides, which mirrors a plain boolean classification.
JEV_ALLOW_MIN_PROBABILITY=

# ---------------------------------------------------------------------------
# Google Gemini (optional alternative provider)
# ---------------------------------------------------------------------------

# Required for the Gemini provider. Create a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# gemini-2.5-flash-lite is fast and stable; gemini-3.1-flash-lite is newer.
# (gemini-3.5-flash-lite exists but is often overloaded with HTTP 503.)
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Filtering policy
# ---------------------------------------------------------------------------

# SEMANTIC DESCRIPTIONS of categories/concepts to block - not literal strings.
# Multi-line values or comma separated. Leave empty to rely on the extension /
# web console (or per-request entries). An empty list blocks nothing.
#
# Legacy alias: SANITY_CHECKER_KEYWORDS is still accepted.
#
# Example:
# SMART_FILTER_ENTRIES="explicit sexual content
# manga and anime (and closely related formats such as manhwa and webtoons) that
# content that encourages wasting hours on endless entertainment instead of studying"
